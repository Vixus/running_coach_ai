# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Database
DB_PATH=/data/coach.db

# Garmin session directory (per-athlete token caching)
GARMIN_SESSION_DIR=/data/garmin_sessions/

# Fernet encryption key for Garmin credentials at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Web dashboard
WEB_SECRET_KEY=
WEB_PORT=8080

# First-deploy admin bootstrap — creates the seed admin athlete on startup.
# Re-running with the same email updates the password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Logging
LOG_LEVEL=INFO
