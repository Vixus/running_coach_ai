# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Slack Bot
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...

# Database
DB_PATH=/data/coach.db

# Garmin session directory (per-athlete token caching)
GARMIN_SESSION_DIR=/data/garmin_sessions/

# Fernet encryption key for Garmin credentials at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Access control
ALLOWED_SLACK_USER_IDS=U012AB3CD,U034EF5GH
ADMIN_SLACK_USER_ID=U012AB3CD

# Logging
LOG_LEVEL=INFO
